#!/usr/bin/env pcl
${import statistics}

${:# 场景：结构化数据经 :read 下发——agent 按需 pcl_read 拉取，不拼进 prompt}
${DATA = [round(60 + 40 * ((i * 37) % 100) / 100, 1) for i in range(24)]}

${:pass :read DATA}
Dataset DATA (24 scores on a 0-100 scale) is ready: call the pcl_read
tool to fetch it by name, then summarize its distribution (range /
median / uniformity) in at most three sentences. Do not list the numbers.
