#!/usr/bin/env pcl
${:# /goal-style goal-achievement loop: two passes per round (act + check), break when done}
${:# Each pass runs in a fresh context (:new) — so every prompt is self-contained:}
${:# goal + accumulated action history + round number}
${ROUND = 0}
${DONE = False}
${W = ""}
${HISTORY = ""}
${MAX = 100}

${:while ROUND < MAX}
    ${ROUND = ROUND + 1}

    ${:# Pass 1: act — fresh context, self-contained prompt}
    ${:new}
    ${:pass :write W}
    Executor (round $(ROUND)/$(MAX)). You run in a fresh context — everything you need is below.
    Task goal: $prompt
    Actions so far:
    $(HISTORY if HISTORY else "(none yet — this is round 1)")
    Take the next action toward the goal, then call pcl_write exactly once with:
    {"W": "one-line action summary"}

    ${HISTORY = HISTORY + (W if isinstance(W, str) else str(W)) + "\n"}

    ${:# Pass 2: check — fresh context, self-contained prompt}
    ${:new}
    ${:pass :write W}
    Inspector (round $(ROUND)/$(MAX)). You run in a fresh context — judge from the evidence below.
    Task goal: $prompt
    Actions so far:
    $(HISTORY)
    Has the goal been achieved? Call pcl_write exactly once with:
    {"W": {"done": true/false, "note": "one-line verdict"}}

    ${:# the :if condition evaluates after writeback — W is Pass 2's result}
    ${:if isinstance(W, dict) and W.get("done")}
        ${DONE = True}
        ${:break}
    ${:fi}
    $(# Round $(ROUND): $(W.get("note", "") if isinstance(W, dict) else "") — ⏳ in progress #)
${:done}

${:if DONE}
$(# 🎉 Goal achieved in round $(ROUND)/$(MAX)#)
${:else}
$(# ⚠️ Round limit reached ($(MAX)), goal not achieved#)
${:fi}
