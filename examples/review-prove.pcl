#!/usr/bin/env pcl
${import json}

${:# Review-and-prove loop: refine claims until all credible (or round limit)}
${:# Final verdict goes out via $(# … #) note output — never enters LLM context}
${ROUND = 0}
${BRAINSTORM = []}
${PENDING = []}
${MAX_ROUNDS = 4}
${TOPIC = prompt}

${:pass :write BRAINSTORM}
You are a rigorous reviewer. Brainstorm all pro and con viewpoints
on the topic below, then call pcl_write exactly once, with the whole
list nested under the single key BRAINSTORM (a string array, may be empty []):
{"BRAINSTORM": ["viewpoint 1", "viewpoint 2", ...]}
Topic: $(TOPIC)

${:while ROUND < MAX_ROUNDS}
    ${ROUND = ROUND + 1}
    ${RESULT = {}}
    ${:new}
    ${:pass :write RESULT}
    You are a rigorous reviewer. Audit each viewpoint below and self-assess:
    - Mark it 【credible】 (common sense / axiom / directly verifiable) or
      【doubtful】 (needs evidence or derivation);
    - For each doubtful viewpoint, prove it in place (reasoning, example or
      lemma), then re-assess;
    - Finally call pcl_write exactly once, with the whole result nested under the
      single key RESULT (a JSON object):
      {"RESULT": {"all": [all reviewed viewpoints], "pending": [still-doubtful ones (string array, may be empty)]}}
      Do not call pcl_write a second time.

    Viewpoints to audit (originally $(len(BRAINSTORM)) items):
    $(json.dumps(BRAINSTORM, ensure_ascii=False))

    $((json.dumps(PENDING, ensure_ascii=False) + "\n") if PENDING else "")
    Current round: $(ROUND)
    ${:# :if condition evaluates after writeback — RESULT is this round's result}
    ${:if isinstance(RESULT, dict) and not (RESULT.get("pending") or [])}
        ${:break}
    ${:fi}
    ${PENDING = RESULT.get("pending") or []}
${:done}

${:if isinstance(RESULT, dict) and not (RESULT.get("pending") or [])}
$(#
✔ All claims credible as of round $(ROUND).
Origin $(len(BRAINSTORM)) / final $(len(RESULT.get("all") or BRAINSTORM)) items:
${:for c in (RESULT.get("all") or BRAINSTORM)}
- $(c)
${:done}
#)
${:else}
$(#
✘ Round limit reached ($(MAX_ROUNDS)), $(len(PENDING)) still doubtful.
All claims ($(len(RESULT.get("all") or BRAINSTORM)) items):
${:for c in (RESULT.get("all") or BRAINSTORM)}
- $(c)
${:done}
Doubtful claims:
${:for c in PENDING}
- $(c)
${:done}
#)
${:fi}
