#!/usr/bin/env pcl
${:# 方案制作 → 评审循环：agent 逐轮操作方案字符串（PLAN）——}
${:# 制作/修订 → 独立评审打分；10 分或轮次上限退出，否则循环}
${ROUND = 0}
${PLAN = ""}
${W = ""}
${MAX = 5}

${:while ROUND < MAX}
    ${ROUND = ROUND + 1}

    ${:# Pass 1: draft/revise——agent 拿当前方案，产出完整修订版（字符串）}
    ${:new}
    ${:pass :write W}
    Planner (round $(ROUND)/$(MAX)).
    Task: $prompt
    Current plan:
    $(PLAN if PLAN else "(empty — write the first draft)")
    Revise it (goal / steps / risks & mitigations / acceptance criteria)
    and call pcl_write exactly once with:
    {"W": "the full revised plan as a single string"}

    ${:# Pass 2: review——独立评审当前方案，写回 score/verdict}
    ${:new}
    ${:# :new 之后 = Pass 1 pass 体外的指令边界——W 已是 Pass 1 写回的方案}
    ${PLAN = W if isinstance(W, str) else str(W)}
    ${:pass :write W}
    Reviewer (round $(ROUND)/$(MAX)).
    Task: $prompt
    Plan under review:
    $(PLAN)
    Score 0-10 (10 = complete, actionable, no gaps). Call pcl_write
    exactly once with:
    {"W": {"score": <int>, "verdict": "one-line verdict"}}

    ${:# :if 条件在写回之后求值——W 即评审结果；直接判 W（防 bool 陷阱），}
    ${:# 中间变量赋值若放在 pass 体内会读到提交前的旧值}
    ${:if isinstance(W, dict) and isinstance(W.get("score"), int) and not isinstance(W.get("score"), bool) and W.get("score") >= 10}
        $(# Round $(ROUND): ⏹ $(W["score"])/10 — plan complete #)
        ${:break}
    ${:fi}
    $(# Round $(ROUND): $(str(W.get("score")) + "/10" if isinstance(W, dict) and isinstance(W.get("score"), int) and not isinstance(W.get("score"), bool) else "?/10") — ⏳ revising #)
${:done}

$(#
=== Final plan (round $(ROUND)/$(MAX)) ===
$(PLAN)
#)
